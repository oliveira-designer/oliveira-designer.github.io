{
  "redirects": [
    {
      "source": "/case-studies/sigmamd-claims-worklist.html",
      "destination": "/#work",
      "statusCode": 301
    },
    {
      "source": "/case-studies/sigmamd-claim-detail.html",
      "destination": "/#work",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/design-organization/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
